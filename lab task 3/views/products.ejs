<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Cougar Clothing Store</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="announcement-bar">
        FLAT 50% OFF ON ALL PRODUCTS-<a href="/sale">SHOP NOW</a>
    </div>
    <header class="header" id="main-header">
        <nav class="nav-left" id="nav-menu">
            <a href="/sale" class="sale-link">Sale</a>
            <a href="/men">Men</a>
            <a href="/women">Women</a>
            <a href="/kids">Kids</a>
            <a href="/new-arrivals">New Arrivals</a>
            <!-- Dynamic nav: show different links based on login status -->
            <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <% if (currentUser.role === "admin") { %>
                    <a href="/admin" class="admin-link">Admin</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
        <div class="logo">
            <a href="/">COUGAR</a>
        </div>
        <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
    </header>

    <!-- Flash Messages -->
    <% if (typeof success !== "undefined" && success.length > 0) { %>
        <div class="flash-bar flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== "undefined" && error.length > 0) { %>
        <div class="flash-bar flash-error"><%= error %></div>
    <% } %>

    <section class="page-content">
        <h1><%= pageTitle %></h1>
        <p><%= pageDescription %></p>

        <!-- Search & Filter Form -->
        <form action="<%= currentRoute %>" method="GET" class="filter-form">
            <div class="filter-group">
                <label for="search">Search</label>
                <input type="text" id="search" name="search" placeholder="Search by name..." value="<%= search %>">
            </div>
            <div class="filter-group">
                <label for="category">Category</label>
                <select id="category" name="category">
                    <option value="">All Categories</option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                </select>
            </div>
            <div class="filter-group">
                <label for="minPrice">Min Price</label>
                <input type="number" id="minPrice" name="minPrice" placeholder="0" min="0" value="<%= minPrice %>">
            </div>
            <div class="filter-group">
                <label for="maxPrice">Max Price</label>
                <input type="number" id="maxPrice" name="maxPrice" placeholder="Any" min="0" value="<%= maxPrice %>">
            </div>
            <div class="filter-buttons">
                <button type="submit" class="btn-filter">Apply</button>
                <a href="<%= currentRoute %>" class="btn-clear">Clear</a>
            </div>
        </form>

        <!-- Results Info -->
        <p class="results-info">
            Showing <strong><%= products.length %></strong> of <strong><%= totalProducts %></strong> products
            (Page <%= currentPage %> of <%= totalPages %>)
        </p>

        <!-- Product Grid -->
        <% if (products.length > 0) { %>
            <div class="products-grid">
                <% products.forEach(function(product) { %>
                    <div class="prod-card">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <div class="prod-card-body">
                            <span class="prod-category"><%= product.category %></span>
                            <h3 class="prod-name"><%= product.name %></h3>
                            <p class="prod-price">Rs. <%= product.price.toLocaleString() %></p>
                            <div class="prod-meta">
                                <span class="prod-rating">&#9733; <%= product.rating %></span>
                                <span class="prod-stock <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                                    <%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %>
                                </span>
                            </div>
                            <!-- Add to Cart Button -->
                            <% if (product.stock > 0) { %>
                                <button class="btn-add-cart" onclick="alert('Added to cart: <%= product.name %>')">Add to Cart</button>
                            <% } else { %>
                                <button class="btn-add-cart btn-disabled" disabled>Out of Stock</button>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-results">
                <h2>No products found</h2>
                <p>Try adjusting your search or filters.</p>
                <a href="<%= currentRoute %>" class="btn-clear">View All Products</a>
            </div>
        <% } %>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="pagination">
                <%
                    var qs = '';
                    if (search) qs += '&search=' + encodeURIComponent(search);
                    if (category) qs += '&category=' + encodeURIComponent(category);
                    if (minPrice) qs += '&minPrice=' + minPrice;
                    if (maxPrice) qs += '&maxPrice=' + maxPrice;
                %>

                <% if (currentPage > 1) { %>
                    <a href="<%= currentRoute %>?page=<%= currentPage - 1 %><%= qs %>" class="page-btn">&larr; Previous</a>
                <% } else { %>
                    <span class="page-btn disabled">&larr; Previous</span>
                <% } %>

                <% for (var i = 1; i <= totalPages; i++) { %>
                    <a href="<%= currentRoute %>?page=<%= i %><%= qs %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="<%= currentRoute %>?page=<%= currentPage + 1 %><%= qs %>" class="page-btn">Next &rarr;</a>
                <% } else { %>
                    <span class="page-btn disabled">Next &rarr;</span>
                <% } %>
            </div>
        <% } %>
    </section>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-column">
              <h4>Customer Support</h4>
             <ul>
                <li><a href="#">Contact Us</a></li>
                <li><a href="#">FAQs</a></li>
                <li><a href="#">Shipping Policy</a></li>
                <li><a href="#">Returns & Exchanges</a></li>
             </ul>
            </div>
             <div class="footer-column">
                <h4>About Cougar</h4>
                <ul>
                    <li><a href="#">FAQ'S</a></li>
                    <li><a href="#">Log in/Sign Up</a></li>
                    <li><a href="#">Shipping &amp; Deliveries</a></li>
                    <li><a href="#">Order Cancellation</a></li>
                    <li><a href="#">Blogs &amp; News</a></li>
                </ul>
            </div>
             <div class="footer-column">
                <h4>Get To Know Us</h4>
                <ul>
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">Feedback / Complaint</a></li>
                    <li><a href="#">Track Your Order</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Return &amp; Exchange Policy</a></li>
                    <li><a href="#">Terms And Condition</a></li>
                </ul>
            </div>
                <div class="newsletter">
                    <h4>Subscribe to our Newsletter</h4>
                    <p>Get updates on sales, new arrivals, and exclusive offers.by entering the correct details, you may get our latest updates on your entered email, don't forget to enter your credentials here.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" required>
                        <button type="submit">Subscribe</button>
                    </form>
                </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
