<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Cougar Store</title>

    <!-- We use a separate CSS file for the admin panel -->
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <!-- ========== SIDEBAR NAVIGATION ========== -->
    <div class="admin-sidebar">
        <h2 class="sidebar-logo">COUGAR</h2>
        <p class="sidebar-subtitle">Admin Panel</p>

        <nav class="sidebar-nav">
            <!-- Link to the dashboard (this page) -->
            <a href="/admin" class="active">Dashboard</a>

            <!-- Link to the "Add Product" form page -->
            <a href="/admin/add">Add Product</a>

            <!-- Link back to the main store homepage -->
            <a href="/">Back to Store</a>
        </nav>
    </div>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <div class="admin-main">

        <h1>Product Dashboard</h1>

        <!-- Show a success message if one was passed (after add/edit/delete) -->
        <% if (typeof success !== "undefined" && success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <!-- Summary: total number of products -->
        <p class="summary-text">Total Products: <strong><%= products.length %></strong></p>

        <!-- ========== PRODUCTS TABLE ========== -->
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price (Rs.)</th>
                    <th>Category</th>
                    <th>Section</th>
                    <th>Stock</th>
                    <th>Rating</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Loop through each product and create a table row -->
                <% products.forEach(function(product) { %>
                    <tr>
                        <!-- Product thumbnail image -->
                        <td>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="table-img">
                        </td>

                        <!-- Product name -->
                        <td><%= product.name %></td>

                        <!-- Product price, formatted with commas -->
                        <td><%= product.price.toLocaleString() %></td>

                        <!-- Product category (e.g. Shirts, Jeans) -->
                        <td><%= product.category %></td>

                        <!-- Product section (e.g. Men, Women, Kids) -->
                        <td><%= product.section %></td>

                        <!-- Stock quantity with color coding -->
                        <td class="<%= product.stock > 0 ? 'stock-in' : 'stock-out' %>">
                            <%= product.stock %>
                        </td>

                        <!-- Star rating -->
                        <td>&#9733; <%= product.rating %></td>

                        <!-- Action buttons: Edit and Delete -->
                        <td class="action-btns">
                            <!-- Edit button links to the edit form, pre-filled with this product's data -->
                            <a href="/admin/edit/<%= product._id %>" class="btn-edit">Edit</a>

                            <!-- Delete button - uses a form so we can send a POST request -->
                            <!-- The onsubmit calls confirm() to show a pop-up before deleting -->
                            <form action="/admin/delete/<%= product._id %>" method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

    </div>

</body>
</html>
