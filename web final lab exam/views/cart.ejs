<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - Cougar Clothing Store</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="announcement-bar">
        FLAT 50% OFF ON ALL PRODUCTS-<a href="/sale">SHOP NOW</a>
    </div>
    <header class="header" id="main-header">
        <nav class="nav-left" id="nav-menu">
            <a href="/sale" class="sale-link">Sale</a>
            <a href="/onsale-products">On Sale</a>
            <a href="/men">Men</a>
            <a href="/women">Women</a>
            <a href="/kids">Kids</a>
            <a href="/new-arrivals">New Arrivals</a>
            <!-- Dynamic nav: show different links based on login status -->
            <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <% if (currentUser.role === "admin") { %>
                    <a href="/admin" class="admin-link">Admin</a>
                <% } else { %>
                    <a href="/cart" class="cart-link">&#128722; Cart (<%= typeof cartCount !== "undefined" ? cartCount : 0 %>)</a>
                    <a href="/my-orders" class="orders-link">My Orders</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
        <div class="logo">
            <a href="/">COUGAR</a>
        </div>
        <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
    </header>

    <!-- Flash Messages -->
    <% if (typeof success !== "undefined" && success.length > 0) { %>
        <div class="flash-bar flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== "undefined" && error.length > 0) { %>
        <div class="flash-bar flash-error"><%= error %></div>
    <% } %>

    <!-- Cart Section -->
    <section class="page-content cart-section">
        <h1>Your Shopping Cart</h1>

        <% if (cart.length > 0) { %>
            <!-- Cart Items -->
            <div class="cart-items">
                <% cart.forEach(function(item) { %>
                    <div class="cart-item">
                        <!-- Product Image -->
                        <div class="cart-item-image">
                            <img src="<%= item.image %>" alt="<%= item.name %>">
                        </div>

                        <!-- Product Info -->
                        <div class="cart-item-info">
                            <h3 class="cart-item-name"><%= item.name %></h3>
                            <p class="cart-item-price">Rs. <%= item.price.toLocaleString() %></p>
                        </div>

                        <!-- Quantity Update Form -->
                        <div class="cart-item-quantity">
                            <form action="/cart/update" method="POST" class="cart-qty-form">
                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                <label for="qty-<%= item.productId %>">Qty:</label>
                                <input type="number" id="qty-<%= item.productId %>" name="quantity" value="<%= item.quantity %>" min="1" max="99">
                                <button type="submit" class="btn-update-qty">Update</button>
                            </form>
                        </div>

                        <!-- Subtotal -->
                        <div class="cart-item-subtotal">
                            <p class="subtotal-label">Subtotal</p>
                            <p class="subtotal-amount">Rs. <%= (item.price * item.quantity).toLocaleString() %></p>
                        </div>

                        <!-- Remove Button -->
                        <div class="cart-item-remove">
                            <form action="/cart/remove/<%= item.productId %>" method="POST">
                                <button type="submit" class="btn-remove-item" onclick="return confirm('Remove this item from your cart?')">&#10005;</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- Cart Summary -->
            <div class="cart-summary">
                <div class="cart-total">
                    <span class="total-label">Grand Total:</span>
                    <span class="total-amount">Rs. <%= grandTotal.toLocaleString() %></span>
                </div>
                <div class="cart-summary-buttons">
                    <a href="/" class="btn-continue-shopping">Continue Shopping</a>
                    <a href="/checkout" class="btn-checkout">Proceed to Checkout</a>
                </div>
            </div>

        <% } else { %>
            <!-- Empty Cart -->
            <div class="cart-empty">
                <p class="empty-icon">&#128722;</p>
                <h2>Your cart is empty</h2>
                <p>Looks like you haven't added any products yet.</p>
                <a href="/" class="btn-continue-shopping">Start Shopping</a>
            </div>
        <% } %>
    </section>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-column">
              <h4>Customer Support</h4>
             <ul>
                <li><a href="#">Contact Us</a></li>
                <li><a href="#">FAQs</a></li>
                <li><a href="#">Shipping Policy</a></li>
                <li><a href="#">Returns & Exchanges</a></li>
             </ul>
            </div>
             <div class="footer-column">
                <h4>About Cougar</h4>
                <ul>
                    <li><a href="#">FAQ'S</a></li>
                    <li><a href="#">Log in/Sign Up</a></li>
                    <li><a href="#">Shipping &amp; Deliveries</a></li>
                    <li><a href="#">Order Cancellation</a></li>
                    <li><a href="#">Blogs &amp; News</a></li>
                </ul>
            </div>
             <div class="footer-column">
                <h4>Get To Know Us</h4>
                <ul>
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">Feedback / Complaint</a></li>
                    <li><a href="#">Track Your Order</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Return &amp; Exchange Policy</a></li>
                    <li><a href="#">Terms And Condition</a></li>
                </ul>
            </div>
                <div class="newsletter">
                    <h4>Subscribe to our Newsletter</h4>
                    <p>Get updates on sales, new arrivals, and exclusive offers.by entering the correct details, you may get our latest updates on your entered email, don't forget to enter your credentials here.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" required>
                        <button type="submit">Subscribe</button>
                    </form>
                </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
