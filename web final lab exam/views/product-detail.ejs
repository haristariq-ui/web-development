<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Cougar Clothing Store</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="announcement-bar">
        FLAT 50% OFF ON ALL PRODUCTS-<a href="/sale">SHOP NOW</a>
    </div>
    <header class="header" id="main-header">
        <nav class="nav-left" id="nav-menu">
            <a href="/sale" class="sale-link">Sale</a>
            <a href="/onsale-products">On Sale</a>
            <a href="/men">Men</a>
            <a href="/women">Women</a>
            <a href="/kids">Kids</a>
            <a href="/new-arrivals">New Arrivals</a>
            <!-- Dynamic nav: show different links based on login status -->
            <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <% if (currentUser.role === "admin") { %>
                    <a href="/admin" class="admin-link">Admin</a>
                <% } else { %>
                    <a href="/cart" class="cart-link">&#128722; Cart (<%= typeof cartCount !== "undefined" ? cartCount : 0 %>)</a>
                    <a href="/my-orders" class="orders-link">My Orders</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
        <div class="logo">
            <a href="/">COUGAR</a>
        </div>
        <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
    </header>

    <!-- Flash Messages -->
    <% if (typeof success !== "undefined" && success.length > 0) { %>
        <div class="flash-bar flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== "undefined" && error.length > 0) { %>
        <div class="flash-bar flash-error"><%= error %></div>
    <% } %>

    <!-- Product Detail Section -->
    <section class="product-detail-section">
        <div class="product-detail-container">
            <!-- Product Image -->
            <div class="product-detail-image">
                <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>

            <!-- Product Info -->
            <div class="product-detail-info">
                <span class="detail-category"><%= product.category %></span>
                <h1 class="detail-name"><%= product.name %></h1>
                <p class="detail-price">Rs. <%= product.price.toLocaleString() %></p>

                <div class="detail-meta">
                    <span class="detail-rating">&#9733; <%= product.rating %> / 5</span>
                    <span class="detail-stock <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                        <%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %>
                    </span>
                </div>

                <div class="detail-section-badge">
                    Section: <strong><%= product.section %></strong>
                </div>

                <!-- Add to Cart Form (only if in stock and user is logged in) -->
                <% if (product.stock > 0) { %>
                    <% if (typeof currentUser !== "undefined" && currentUser) { %>
                        <!-- Logged in - show quantity selector and add to cart -->
                        <form action="/cart/add" method="POST" class="add-to-cart-form">
                            <input type="hidden" name="productId" value="<%= product._id %>">

                            <div class="quantity-selector">
                                <label for="quantity">Quantity:</label>
                                <div class="quantity-controls">
                                    <button type="button" class="qty-btn" id="qty-minus">&#8722;</button>
                                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="<%= product.stock %>" readonly>
                                    <button type="button" class="qty-btn" id="qty-plus">&#43;</button>
                                </div>
                            </div>

                            <button type="submit" class="btn-add-to-cart-detail">Add to Cart</button>
                        </form>
                    <% } else { %>
                        <!-- Not logged in - show login prompt -->
                        <div class="login-prompt">
                            <p>Please login to add items to your cart.</p>
                            <a href="/login" class="btn-login-prompt">Login to Continue</a>
                        </div>
                    <% } %>
                <% } else { %>
                    <button class="btn-add-to-cart-detail btn-disabled" disabled>Out of Stock</button>
                <% } %>

                <a href="javascript:history.back()" class="btn-back">&larr; Back to Products</a>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-column">
              <h4>Customer Support</h4>
             <ul>
                <li><a href="#">Contact Us</a></li>
                <li><a href="#">FAQs</a></li>
                <li><a href="#">Shipping Policy</a></li>
                <li><a href="#">Returns & Exchanges</a></li>
             </ul>
            </div>
             <div class="footer-column">
                <h4>About Cougar</h4>
                <ul>
                    <li><a href="#">FAQ'S</a></li>
                    <li><a href="#">Log in/Sign Up</a></li>
                    <li><a href="#">Shipping &amp; Deliveries</a></li>
                    <li><a href="#">Order Cancellation</a></li>
                    <li><a href="#">Blogs &amp; News</a></li>
                </ul>
            </div>
             <div class="footer-column">
                <h4>Get To Know Us</h4>
                <ul>
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">Feedback / Complaint</a></li>
                    <li><a href="#">Track Your Order</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Return &amp; Exchange Policy</a></li>
                    <li><a href="#">Terms And Condition</a></li>
                </ul>
            </div>
                <div class="newsletter">
                    <h4>Subscribe to our Newsletter</h4>
                    <p>Get updates on sales, new arrivals, and exclusive offers.by entering the correct details, you may get our latest updates on your entered email, don't forget to enter your credentials here.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" required>
                        <button type="submit">Subscribe</button>
                    </form>
                </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>

    <!-- Quantity Selector Script -->
    <script>
        // Quantity controls for the product detail page
        let qtyInput = document.getElementById("quantity");
        let minusBtn = document.getElementById("qty-minus");
        let plusBtn = document.getElementById("qty-plus");

        if (minusBtn && plusBtn && qtyInput) {
            minusBtn.addEventListener("click", function () {
                let current = parseInt(qtyInput.value);
                if (current > 1) {
                    qtyInput.value = current - 1;
                }
            });

            plusBtn.addEventListener("click", function () {
                let current = parseInt(qtyInput.value);
                let max = parseInt(qtyInput.getAttribute("max"));
                if (current < max) {
                    qtyInput.value = current + 1;
                }
            });
        }
    </script>
</body>
</html>
