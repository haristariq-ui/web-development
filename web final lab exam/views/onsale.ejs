<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Cougar Clothing Store</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="announcement-bar">
        FLAT 50% OFF ON ALL PRODUCTS-<a href="/sale">SHOP NOW</a>
    </div>
    <header class="header" id="main-header">
        <nav class="nav-left" id="nav-menu">
            <a href="/sale" class="sale-link">Sale</a>
            <a href="/onsale-products">On Sale</a>
            <a href="/men">Men</a>
            <a href="/women">Women</a>
            <a href="/kids">Kids</a>
            <a href="/new-arrivals">New Arrivals</a>
            <!-- Dynamic nav: show different links based on login status -->
            <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <% if (currentUser.role === "admin") { %>
                    <a href="/admin" class="admin-link">Admin</a>
                <% } else { %>
                    <a href="/cart" class="cart-link">&#128722; Cart (<%= typeof cartCount !== "undefined" ? cartCount : 0 %>)</a>
                    <a href="/my-orders" class="orders-link">My Orders</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
        <div class="logo">
            <a href="/">COUGAR</a>
        </div>
        <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
    </header>

    <!-- Flash Messages -->
    <% if (typeof success !== "undefined" && success.length > 0) { %>
        <div class="flash-bar flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== "undefined" && error.length > 0) { %>
        <div class="flash-bar flash-error"><%= error %></div>
    <% } %>

    <section class="page-content">
        <h1><%= pageTitle %></h1>
        <p><%= pageDescription %></p>

        <p class="results-info">
            Showing <strong><%= products.length %></strong> on-sale products
        </p>

        <div id="product-list" class="products-grid">
            <% if (products.length > 0) { %>
                <% products.forEach(function(product) { %>
                    <div class="prod-card onsale-card">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <div class="prod-card-body">
                            <span class="prod-category"><%= product.category %></span>
                            <h3 class="prod-name"><%= product.name %></h3>
                            <p class="prod-price">Rs. <%= product.price.toLocaleString() %></p>
                            <div class="prod-meta">
                                <span class="prod-rating">&#9733; <%= product.rating %></span>
                                <span class="prod-stock <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                                    <%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %>
                                </span>
                            </div>
                            <% if (product.stock > 0) { %>
                                <% if (typeof currentUser !== "undefined" && currentUser) { %>
                                    <a href="/product/<%= product._id %>" class="btn-add-cart" style="display:block;text-align:center;text-decoration:none;">Add to Cart</a>
                                <% } else { %>
                                    <button class="btn-add-cart" onclick="showLoginModal()">Add to Cart</button>
                                <% } %>
                            <% } else { %>
                                <button class="btn-add-cart btn-disabled" disabled>Out of Stock</button>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <% if (products.length === 0) { %>
            <div class="no-results">
                <h2>No on-sale products found</h2>
                <p>Please check back later for new deals.</p>
                <a href="/" class="btn-clear">Back to Home</a>
            </div>
        <% } %>

        <div class="pagination">
            <button id="prev-page" class="page-btn">&larr; Previous</button>
            <span id="page-indicator" class="page-btn disabled">Page 1 of 1</span>
            <button id="next-page" class="page-btn">Next &rarr;</button>
        </div>
    </section>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-column">
              <h4>Customer Support</h4>
             <ul>
                <li><a href="#">Contact Us</a></li>
                <li><a href="#">FAQs</a></li>
                <li><a href="#">Shipping Policy</a></li>
                <li><a href="#">Returns & Exchanges</a></li>
             </ul>
            </div>
             <div class="footer-column">
                <h4>About Cougar</h4>
                <ul>
                    <li><a href="#">FAQ'S</a></li>
                    <li><a href="#">Log in/Sign Up</a></li>
                    <li><a href="#">Shipping &amp; Deliveries</a></li>
                    <li><a href="#">Order Cancellation</a></li>
                    <li><a href="#">Blogs &amp; News</a></li>
                </ul>
            </div>
             <div class="footer-column">
                <h4>Get To Know Us</h4>
                <ul>
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">Feedback / Complaint</a></li>
                    <li><a href="#">Track Your Order</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Return &amp; Exchange Policy</a></li>
                    <li><a href="#">Terms And Condition</a></li>
                </ul>
            </div>
                <div class="newsletter">
                    <h4>Subscribe to our Newsletter</h4>
                    <p>Get updates on sales, new arrivals, and exclusive offers.by entering the correct details, you may get our latest updates on your entered email, don't forget to enter your credentials here.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" required>
                        <button type="submit">Subscribe</button>
                    </form>
                </div>
        </div>
    </footer>

    <!-- Login Required Popup Modal (only shown to guests) -->
    <% if (!(typeof currentUser !== "undefined" && currentUser)) { %>
    <div class="login-modal-overlay" id="loginModal">
        <div class="login-modal">
            <button class="login-modal-close" onclick="hideLoginModal()">&times;</button>
            <div class="login-modal-icon">&#128274;</div>
            <h2>Login Required</h2>
            <p>Please login to add items to your cart.</p>
            <div class="login-modal-buttons">
                <a href="/login" class="btn-modal-login">Login</a>
                <button class="btn-modal-cancel" onclick="hideLoginModal()">Cancel</button>
            </div>
            <p class="login-modal-register">Don't have an account? <a href="/register">Register here</a></p>
        </div>
    </div>
    <% } %>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/onsale.js"></script>
    <script src="/js/main.js"></script>

    <!-- Login Modal Script -->
    <script>
        function showLoginModal() {
            document.getElementById('loginModal').classList.add('active');
        }

        function hideLoginModal() {
            document.getElementById('loginModal').classList.remove('active');
        }

        // Close modal when clicking outside of it
        var overlay = document.getElementById('loginModal');
        if (overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) {
                    hideLoginModal();
                }
            });
        }
    </script>
</body>
</html>
